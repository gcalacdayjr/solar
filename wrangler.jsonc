{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "solar",
  "main": "src/index.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SISELI_BASE_URL": "https://solar.siseli.com",
    "SISELI_TIMEZONE": "Asia/Manila",
    "SISELI_OPEN_APP_ID": "wx22020b47fb0a4a01",
    "ELECTRICITY_RATE_PHP": "15.00"
  }
}
